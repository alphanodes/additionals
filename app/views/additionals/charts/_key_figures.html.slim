/ Key figures above a chart, each { label:, value:, note:, alert: }; an alert
/ marks the figure that needs attention
- if figures.any?
  .additionals-key-figures
    - figures.each do |figure|
      div class=['additionals-key-figure', ('key-figure-alert' if figure[:alert])]
        .key-figure-label = figure[:label]
        .key-figure-value = figure[:value]
        - if figure[:note]
          .key-figure-note = figure[:note]
