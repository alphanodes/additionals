/ Form partial of the number list format (NumberListFormat). Like the core
/ list, without multiple values and links: one number per line, with an
/ optional prefix and suffix (text and icon) for the display.
p
  = f.textarea :possible_values, value: custom_field.possible_values.to_a.join("\n"), rows: 15, required: true
  em.info = l :text_number_list_possible_values_info
p = f.text_field :default_value
p
  label for='custom_field_value_prefix' = l :field_value_prefix
  = additionals_icon_select_tag 'custom_field[value_prefix_icon]', custom_field.value_prefix_icon,
                                id: 'custom_field_value_prefix_icon'
  '
  = f.text_field :value_prefix, size: 10, no_label: true
p
  label for='custom_field_value_suffix' = l :field_value_suffix
  = f.text_field :value_suffix, size: 10, no_label: true
  '
  = additionals_icon_select_tag 'custom_field[value_suffix_icon]', custom_field.value_suffix_icon,
                                id: 'custom_field_value_suffix_icon'
  em.info = l :text_number_list_affix_info
p = edit_tag_style_tag f
= additionals_icon_loader width: '180px', placeholder: l(:field_icon)
