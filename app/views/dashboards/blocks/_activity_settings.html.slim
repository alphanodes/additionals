.box.tabular.settings
  p
    = additionals_settings_numberfield :max_entries,
                                       value: dashboard_block.max_entries,
                                       tag_name: "settings[#{block}][max_entries]",
                                       min: 1, max: 1000, required: true
  p
    = additionals_settings_checkbox :me_only,
                                    label: :label_only_my_activities,
                                    active_value: dashboard_block.me_only,
                                    tag_name: "settings[#{block}][me_only]"
