- with_async = dashboard_async_required_settings? settings, async

- unless with_async
  h3 = settings[:title].presence || dashboard_block.label

/ Like the form of a block rendered with the page: not on a locked dashboard
- if dashboard.layout_editable? && !dashboard_block.no_settings?
  = render 'dashboards/blocks/settings_form',
           dashboard:, block:, dashboard_block:, hidden: with_async,
           new_block: new_dashboard_block?(dashboard_block, settings),
           fields_partial: dashboard_block.settings_partial,
           fields_locals: build_dashboard_partial_locals(block, settings, dashboard).merge(with_async:)

- if with_async
  = render_async_cache(dashboard_async_block_path(dashboard, block, async, settings),
                       **render_async_options(settings, async)) do
    .clear-both
    p
      = svg_icon_tag 'refresh', css_class: 'additionals-spin'
      '
      = l :label_loading

  javascript:
    $(function() {
      $('#ajax-indicator').hide();
    })
/ The open settings form of a new block tells what is missing
- elsif !(dashboard.layout_editable? && new_dashboard_block?(dashboard_block, settings))
  p.nodata = l :label_no_data
