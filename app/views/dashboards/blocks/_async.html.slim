- with_async = dashboard_async_required_settings? settings, async

- unless with_async
  h3 = settings[:title].presence || dashboard_block.label

- if @can_edit && !dashboard_block.no_settings?
  div id="#{block}-settings" class="#{'hidden' if with_async}"
    / A multiple select only submits the options that are marked, and the columns in the
    / right-hand list are not - so without this the column choice never reaches the server
    / and the block keeps the columns of its query.
    = remote_form_tag _update_layout_setting_dashboard_path(@project, dashboard),
                      onsubmit: "$(this).find('select[id^=selected_] option').prop('selected', true)" do
      = render dashboard_block.settings_partial.presence || "#{async[:partial]}_settings",
               build_dashboard_partial_locals(block, settings, dashboard).merge(with_async:)

      p
        = submit_tag l(:button_save)
        '
        = link_to_function l(:button_cancel), "$('##{block}-settings').toggle()"

- if with_async
  = render_async_cache(dashboard_async_block_path(dashboard, block, async, settings),
                       **render_async_options(settings, async)) do
    .clear-both
    p
      = svg_icon_tag 'refresh', css_class: 'additionals-spin'
      '
      = l :label_loading

  javascript:
    $(function() {
      $('#ajax-indicator').hide();
    })
- else
  p.nodata = l :label_no_data
