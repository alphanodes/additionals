- dashboard_async_cache dashboard, block, async, settings do
  - chart = dashboard_block.data

  h3.icon = svg_icon_tag chart.icon, label: dashboard_block.title
  - if dashboard_block.description.present?
    .wiki.query-description = textilizable dashboard_block.description

  - if chart.valid?
    .additionals-block.additionals-query-chart
      .additionals-chart-wrapper style="--query-chart-height: #{chart.height}px;"
        - unless chart.table_only?
          .additionals-chart-left
            div[id="query-chart-#{block}"
                style="height: #{chart.height}px;"
                data-controller='additionals-chart'
                data-additionals-chart-payload-value=query_chart_payload(chart).to_json]
              - unless chart.treemap?
                canvas data-additionals-chart-target='canvas'
        - if chart.with_table?
          .additionals-table-of-values class=('cross-table' if chart.split?)
            = render 'dashboards/blocks/query_chart_table', chart:
      .clear-both
      - if chart.counted_several_times?
        em.info = l :info_chart_counted_several_times
      - elsif chart.parts_counted_several_times?
        em.info = l :info_chart_parts_counted_several_times
      = query_chart_query_descriptions chart
  - else
    p.nodata = chart.unavailable_text || l(:label_no_data)
