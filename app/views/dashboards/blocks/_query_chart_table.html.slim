table.list.issue-report.values
  caption
    = svg_icon_tag 'list-details', label: :label_table_of_values, size: 16
  thead
    tr
      th = chart.group_column.caption
      - if chart.split?
        - chart.split_keys.each do |key|
          th = chart.split_label key
        th = chart.measure_label
      - else
        - chart.series_labels.each do |series_label|
          th = chart.compare? ? series_label : chart.measure_label
      th = l :label_percentage
  tbody
    - chart.entries.each do |entry|
      tr class="#{cycle 'odd', 'even'}"
        td.name = entry.url ? link_to(entry.label, entry.url) : entry.label
        - if chart.split?
          - chart.split_keys.each do |key|
            td = query_chart_part_cell chart, entry, key
        td = format_query_chart_value chart, entry.value
        - if chart.compare?
          td = format_query_chart_value chart, entry.compare_value
        td = l :label_percent_value, value: chart.share(entry)
  tfoot
    tr.total
      td.name = l :label_total
      - if chart.split?
        - chart.split_keys.each do |key|
          td = format_query_chart_value chart, chart.split_total(key)
      td = format_query_chart_value chart, chart.total
      - if chart.compare?
        td = format_query_chart_value chart, chart.compare_total
      td
